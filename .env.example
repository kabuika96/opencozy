OPENCOZY_HOST=0.0.0.0
OPENCOZY_PORT=8788
OPENCOZY_FRONTEND_PORT=5175
OPENCOZY_DB_PATH=./data/opencozy.sqlite
OPENCOZY_CODEX_BIN=codex
# Defaults to the OS user's home directory when unset.
# OPENCOZY_CODEX_CWD=/path/to/default/project

# Optional comma-separated browser-facing hostnames accepted by the frontend
# and backend origin guard. Include every hostname or IP you intend to open
# in the browser.
# OPENCOZY_ALLOWED_HOSTS=opencozy.local,jarvis.your-tailnet.ts.net

# Private WAN via Tailscale Serve:
# - Bind the backend to localhost.
# - Keep the Vite frontend as the only browser-facing OpenCozy origin.
# - Check config with: npm run private-wan:doctor
# - Start local services plus WAN with: npm run wan:start
# - Disable only Serve with: npm run private-wan:stop
# OPENCOZY_HOST=127.0.0.1
# Optional when using a non-default Tailscale daemon socket.
# OPENCOZY_TAILSCALE_SOCKET=/Users/you/.local/share/opencozy-tailscale/tailscaled.sock

# Project Preview publishing via Tailscale Serve uses private HTTPS ports in
# this range for preview targets and browser-direct dependency services.
# OPENCOZY_PREVIEW_PUBLISH_PORT_START=8443
# OPENCOZY_PREVIEW_PUBLISH_PORT_END=8499

# OpenCozy uses a separate localhost-only proxy port for each published
# preview origin. If a planned proxy port is occupied, OpenCozy will try the
# next available port in this range and update the Tailscale Serve target.
# OPENCOZY_PREVIEW_PROXY_PORT_START=19000
# OPENCOZY_PREVIEW_PROXY_PORT_END=19999
