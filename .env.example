LITEHARNESS_FRONTEND_HOST=127.0.0.1
LITEHARNESS_FRONTEND_PORT=5173
LITEHARNESS_BACKEND_HOST=127.0.0.1
LITEHARNESS_BACKEND_PORT=8787
LITEHARNESS_DB_PATH=./data/liteharness.sqlite

# app-server keeps Codex warm for streaming, steering, approvals, and subagents.
# Use mock only for UI/backend smoke tests.
LITEHARNESS_CODEX_MODE=app-server
# Main/subagent model and effort come from Balance, Speed, or Power.
# LITEHARNESS_MODEL settings below apply only to utility model calls.

# Native whatsapp.send_message tool. The recipient stays fixed outside model arguments.
LITEHARNESS_WHATSAPP_CHAT_ID=
LITEHARNESS_WHATSAPP_BRIDGE_PORT=3000

# Manual context compaction can use the ChatGPT Codex Responses-compatible endpoint.
# Event presentation stays off the model hot path; compaction is explicitly requested.
# Token resolution falls back to local Codex/Hermes auth stores when explicit tokens are omitted.
LITEHARNESS_CHATGPT_CODEX_RESPONSES_URL=https://chatgpt.com/backend-api/codex/responses
LITEHARNESS_CHATGPT_AUTH_STORE=
LITEHARNESS_CHATGPT_TOKEN=
LITEHARNESS_MODEL_TOKEN=
LITEHARNESS_MODEL=gpt-6-astra
LITEHARNESS_MODEL_REASONING_EFFORT=xhigh

# Explicit context compaction summarizes older visible timeline history.
# New Run submission never invokes automatic Opencozy compaction.
LITEHARNESS_COMPACTION_CONTEXT_TOKENS=200000
LITEHARNESS_COMPACTION_PROTECT_FIRST_EVENTS=3
LITEHARNESS_COMPACTION_PROTECT_LAST_EVENTS=20
LITEHARNESS_COMPACTION_TAIL_TOKENS=

# Browser-facing hostnames accepted by Vite when publishing through LAN or Tailscale Serve.
LITEHARNESS_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional legacy single Vite host allowlist entry when publishing through Tailscale Serve.
# Example: opencozy.your-tailnet.ts.net
LITEHARNESS_TAILSCALE_HOST=

# Private WAN paths default to the current user’s home; set LITEHARNESS_TAILSCALED_BIN if tailscaled is installed outside /usr/local/opt/tailscale/bin.

# Project Preview private publishing uses Tailscale Serve plus a localhost proxy.
LITEHARNESS_TAILSCALE_BIN=tailscale
LITEHARNESS_PREVIEW_PUBLISH_PORT_START=8443
LITEHARNESS_PREVIEW_PUBLISH_PORT_END=8499
LITEHARNESS_PREVIEW_PROXY_PORT_START=19000
LITEHARNESS_PREVIEW_PROXY_PORT_END=19999

# Read-only OpenWrite record search and previews; must remain loopback HTTP.
# Set this to your separately running OpenWrite instance (use a different port from this backend).
# LITEHARNESS_OPENWRITE_ORIGIN=http://127.0.0.1:8788
