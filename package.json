{
  "name": "opencozy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "check": "npm run typecheck --workspaces && npm run test --workspaces && npm run build --workspaces",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm run dev --workspace @opencozy/backend",
    "dev:frontend": "npm run dev --workspace @opencozy/frontend",
    "lint": "npm run typecheck --workspaces",
    "private-wan:doctor": "node scripts/private-wan.mjs doctor",
    "private-wan:serve": "node scripts/private-wan.mjs serve",
    "private-wan:status": "node scripts/private-wan.mjs status",
    "private-wan:stop": "node scripts/private-wan.mjs stop",
    "services:install": "scripts/liteharness-services.sh install",
    "services:logs": "scripts/liteharness-services.sh logs",
    "services:restart": "scripts/liteharness-services.sh restart",
    "services:start": "scripts/liteharness-services.sh start",
    "services:status": "scripts/liteharness-services.sh status",
    "services:stop": "scripts/liteharness-services.sh stop",
    "tailscale-userspace:install": "scripts/liteharness-tailscale-userspace.sh install",
    "tailscale-userspace:logs": "scripts/liteharness-tailscale-userspace.sh logs",
    "tailscale-userspace:restart": "scripts/liteharness-tailscale-userspace.sh restart",
    "tailscale-userspace:start": "scripts/liteharness-tailscale-userspace.sh start",
    "tailscale-userspace:status": "scripts/liteharness-tailscale-userspace.sh status",
    "tailscale-userspace:stop": "scripts/liteharness-tailscale-userspace.sh stop",
    "test": "npm run test --workspaces",
    "test:writer-isolation": "node --import tsx scripts/check-writer-isolation.ts",
    "test:prompt-cache": "node --import tsx scripts/check-prompt-cache.ts",
    "typecheck": "npm run typecheck --workspaces",
    "wan:start": "npm run services:start && npm run private-wan:serve",
    "wan:status": "npm run services:status && npm run private-wan:status",
    "wan:stop": "npm run private-wan:stop && npm run services:stop",
    "test:action-approval": "node --import tsx scripts/check-action-approval.ts",
    "test:file-tools": "node --import tsx scripts/check-action-approval.ts --files"
  },
  "description": "A mobile-first, local-first control plane for Codex.",
  "repository": {
    "type": "git",
    "url": "https://github.com/kabuika96/opencozy.git"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
