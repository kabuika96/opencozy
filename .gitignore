# Dependencies
node_modules/

# Build and test output
dist/
coverage/
.vite/
.turbo/
.cache/
*.tsbuildinfo

# Local configuration
.env*
!.env.example
*.local

# Local runtime state. Keep the directory so fresh clones have a predictable
# place for app data, but never commit local session DBs or user data.
data/**
!data/
!data/.gitkeep

# Agent scratch space and generated local planning notes.
.scratch/

# Local OS/editor files
.DS_Store
*.swp

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
